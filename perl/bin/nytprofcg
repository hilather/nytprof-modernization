#!/usr/bin/env perl
# Familiar 6.15-style name → sibling nytprof-engine callgrind (I03).
use strict;
use warnings;
use FindBin;
use File::Spec;

my $engine = File::Spec->catfile( $FindBin::Bin, 'nytprof-engine' );
exec $^X, $engine, 'callgrind', @ARGV
  or die "nytprofcg: cannot exec $engine: $!\n";
