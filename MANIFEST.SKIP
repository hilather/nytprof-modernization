# J01 — product dist must not ship oracle pin, build trees, or install prefix.
# ExtUtils::Manifest regexes (matched against repo-relative paths).

^baseline/
^target/
^prefix/
^crates/
^collector/build/
^fixtures/
^\.git/
__pycache__/
\.pyc$
^blib/
^pm_to_blib$
^Makefile$
^Makefile\.old$
^MYMETA\.
^META\.json$
^META\.yml$
^nytprof-packaging\.mode$
^nytprof\.out$
^Devel-NYTProf-.*\.tar\.gz$
^Devel-NYTProf-\d
^NYTProfM-.*\.tar\.gz$
^NYTProfM-\d
^dist/
\.bak$
\.swp$
~$
